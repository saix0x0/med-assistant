# Copy to .env at the event. Without this file the app runs in MOCK mode.
#
# 1) paste the key you get from Sarvam:
SARVAM_API_KEY=
# 2) flip the switch to go live:
MODE=mock          # mock = offline demo | sarvam = real APIs
#
# Optional — only if a default model id is rejected (run tests/smoke_sarvam.py):
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_STT_MODEL=saaras:v4
# TTS_PROVIDER=browser     # browser = Web Speech (free) | bulbul = Sarvam TTS
