# Copy to .env to use live Sarvam models. Without it the app runs in mock mode.
#
# 1) paste the key you get from Sarvam:
SARVAM_API_KEY=
# 2) flip the switch to go live:
MODE=mock          # mock = offline demo | sarvam = real APIs
#
# Optional — only if a default model id is rejected (run python -m scripts.smoke_sarvam):
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_STT_MODEL=saaras:v4
# TTS_PROVIDER=browser     # browser = Web Speech (free) | bulbul = Sarvam TTS
